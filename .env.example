# ═══════════════════════════════════════════════════════════════
# BeamMP Panel — Configuration
# ═══════════════════════════════════════════════════════════════
# Copier ce fichier en .env et adapter les valeurs.
# ═══════════════════════════════════════════════════════════════

# ─── Application ──────────────────────────────────────────────
APP_PORT=3000

# OBLIGATOIRE — clé secrète JWT (min 32 caractères).
# Générer : openssl rand -hex 32
JWT_SECRET=change-me-generate-with-openssl-rand-hex-32

# Mettre true si le panel est derrière un reverse proxy HTTPS (Caddy, Nginx…)
COOKIE_SECURE=false

# Adresse (ou CIDR) du reverse proxy en amont, si applicable (ex:
# 127.0.0.1 pour Caddy/Nginx sur la même machine). Nécessaire pour que le
# rate-limit de /api/auth/login lise la vraie IP du client plutôt que celle
# du proxy. Laisser vide si le panel est exposé directement (aucun proxy) —
# sinon un attaquant peut forger X-Forwarded-For pour contourner le
# rate-limit. Accepte aussi une liste séparée par des virgules, ou `true`
# pour faire confiance à tous les sauts (déconseillé sauf réseau entièrement
# maîtrisé).
# TRUST_PROXY=127.0.0.1

# Origine autorisée pour les requêtes cross-origin (CORS).
# Mettre l'URL publique du panel si différente du port par défaut.
# Si absent → même origine uniquement (recommandé).
ALLOWED_ORIGIN=

# SuperAdmin créé automatiquement au premier démarrage si aucun user n'existe.
SUPERADMIN_USERNAME=admin
SUPERADMIN_PASSWORD=changeme123

# Avancé — rarement nécessaire :
# PORT             : port d'écoute interne au conteneur (défaut 3000). Ne pas
#                    confondre avec APP_PORT ci-dessus, qui remappe le port
#                    hôte ; changer PORT sans adapter docker-compose.yml casse
#                    le healthcheck et le mapping de port.
# IMAGES_PATH      : chemin interne au conteneur pour les images de mods
#                    (défaut /app/images, monté sur le volume app_images).
# INSTANCE_NAME    : nom affiché pour l'instance par défaut en mode
#                    instance unique (défaut "BeamMP Server").
# PORT=3000
# IMAGES_PATH=/app/images
# INSTANCE_NAME=BeamMP Server

# ─── PostgreSQL ───────────────────────────────────────────────
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=beammp
POSTGRES_USER=beammp
# OBLIGATOIRE en production
POSTGRES_PASSWORD=beammp

# ═══════════════════════════════════════════════════════════════
# INSTANCE UNIQUE
# (Pour plusieurs serveurs, voir section MULTI-INSTANCE en bas)
# ═══════════════════════════════════════════════════════════════

# ─── API publique BeamMP ──────────────────────────────────────
# Récupère les infos en temps réel (joueurs, carte…)
# via https://backend.beammp.com/servers-info
BEAMMP_SERVER_IP=
BEAMMP_SERVER_PORT=

# ─── Chemins fichiers BeamMP ──────────────────────────────────
# Chemins sur l'HÔTE (Linux ou Windows) — montés en volumes Docker.
# Ces variables servent à deux choses dans docker-compose.yml :
#   1. Source du volume    : ${BEAMMP_RESOURCES_PATH}:/beammp/resources
#   2. Fallback si non surchargé par le docker-compose (ne pas modifier les
#      valeurs /beammp/... dans docker-compose.yml).
#
# Linux  : /home/user/BeamMP-Server/Resources
# Windows: C:\Users\user\BeamMP-Server\Resources
BEAMMP_RESOURCES_PATH=/home/user/BeamMP-Server/Resources

# BEAMMP_LOG_DIR = le DOSSIER qui contient Server.log, pas le fichier lui-même.
# BeamMP-Server recrée Server.log (renomme l'ancien en Server.old.log) à
# chaque démarrage au lieu de le tronquer sur place — un bind mount Docker sur
# le fichier seul resterait accroché à l'ancien inode et ne verrait plus jamais
# rien après un redémarrage du serveur (voir docker-compose.yml). D'où le
# montage du dossier entier.
BEAMMP_LOG_DIR=/home/user/BeamMP-Server
# BEAMMP_LOG_PATH : n'est plus utilisée que comme chemin interne fixe au
# conteneur (écrasée dans docker-compose.yml) — laisser telle quelle.
BEAMMP_LOG_PATH=/home/user/BeamMP-Server/Server.log
BEAMMP_CONFIG_PATH=/home/user/BeamMP-Server/ServerConfig.toml

# ─── API HTTP BeamMP (optionnel) ──────────────────────────────
# Si vous avez le plugin HTTP BeamMP installé sur le serveur.
# Permet la récupération locale des joueurs connectés.
# BEAMMP_API_HOST=localhost
# BEAMMP_API_PORT=4444

# ─── beammp-agent (optionnel — redémarrage réel du serveur) ───
# Daemon HTTP à installer sur l'hôte (hors Docker) : /opt/beammp-agent/
# Voir /opt/beammp-agent/beammp-agent.py. Sans ces 3 variables, le bouton
# de redémarrage reste désactivé (501).
# BEAMMP_AGENT_URL=http://127.0.0.1:4445
# BEAMMP_AGENT_TOKEN=générer avec openssl rand -hex 32, doit correspondre à RESTART_TOKEN côté agent
# BEAMMP_AGENT_SERVICE=beammp.service
#
# Optionnel — active le bouton de mise à jour du serveur (Configuration) :
# télécharge et installe la dernière release BeamMP-Server officielle depuis
# GitHub via l'agent (vérifie le sha256 avant d'installer). Nécessite aussi
# BEAMMP_BINARY_PATH côté agent (voir beammp-agent.service). Valeur = suffixe
# exact d'un asset de https://github.com/BeamMP/BeamMP-Server/releases
# (ex. "debian.13.x86_64", voir `uname -m` + `/etc/os-release`).
# BEAMMP_AGENT_ASSET=debian.13.x86_64

# ─── Page publique (optionnel) ────────────────────────────────
# SERVER_DESCRIPTION=Bienvenue sur notre serveur BeamMP !
# KOFI_URL=https://ko-fi.com/votre-page

# ─── Discord (optionnel) ──────────────────────────────────────
DISCORD_WEBHOOK_URL=
DISCORD_WEBHOOK_RESTART=
DISCORD_WEBHOOK_PLAYERS=
DISCORD_WEBHOOK_MODS=
# DISCORD_SERVER_URL=https://discord.gg/votre-invitation

DISCORD_NOTIFY_JOIN=true
DISCORD_NOTIFY_LEAVE=true
DISCORD_NOTIFY_MOD_UPLOAD=true
DISCORD_NOTIFY_MAP_CHANGE=true
DISCORD_NOTIFY_RESTART=true

# ═══════════════════════════════════════════════════════════════
# MULTI-INSTANCE (décommenter pour gérer plusieurs serveurs)
# ═══════════════════════════════════════════════════════════════
# Chaque instance a ses propres chemins (montés via des volumes dédiés).
# INSTANCE_*_BEAMMP_LOG_PATH est ici le chemin CONTENEUR (pas hôte) — le
# dossier hôte correspondant se monte dans docker-compose.yml (voir README,
# section Multi-instance : monter le DOSSIER contenant Server.log, jamais le
# fichier seul).

# INSTANCES=main,event

# INSTANCE_MAIN_NAME=Serveur Principal
# INSTANCE_MAIN_SERVER_IP=1.2.3.4
# INSTANCE_MAIN_SERVER_PORT=30814
# INSTANCE_MAIN_BEAMMP_RESOURCES_PATH=/beammp/main/resources
# INSTANCE_MAIN_BEAMMP_LOG_PATH=/beammp/main/logs/Server.log
# INSTANCE_MAIN_BEAMMP_CONFIG_PATH=/beammp/main/ServerConfig.toml
# INSTANCE_MAIN_AGENT_SERVICE=beammp-main.service

# INSTANCE_EVENT_NAME=Serveur Évènement
# INSTANCE_EVENT_SERVER_IP=1.2.3.4
# INSTANCE_EVENT_SERVER_PORT=30815
# INSTANCE_EVENT_BEAMMP_RESOURCES_PATH=/beammp/event/resources
# INSTANCE_EVENT_BEAMMP_LOG_PATH=/beammp/event/logs/Server.log
# INSTANCE_EVENT_BEAMMP_CONFIG_PATH=/beammp/event/ServerConfig.toml
# INSTANCE_EVENT_AGENT_SERVICE=beammp-event.service
